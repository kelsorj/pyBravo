# Copy this file to .env in the repository root and fill in what you need.
# .env is gitignored — never commit real keys.
#
# Everything here is OPTIONAL. pyBravo runs the server, the UI, the 3D view,
# and simulation mode with none of these set.

# ---------------------------------------------------------------------------
# LLM protocol drafter  (requires the `llm` extra: pip install -e '.[llm]')
# ---------------------------------------------------------------------------
# Only the key for the provider you actually use is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider and model the drafter uses.
# PYBRAVO_DRAFTER_PROVIDER=anthropic
# PYBRAVO_DRAFTER_MODEL=claude-sonnet-5

# Where drafted workflows and source PDFs live.
# PYBRAVO_DRAFTER_LOCAL_STORE=
# PYBRAVO_DRAFTER_PDF_DIR=
# PYBRAVO_DRAFTER_MONGO_URI=
# PYBRAVO_DRAFTER_MONGO_DB=

# Optional Docling service for parsing paper PDFs.
# PYBRAVO_DOCLING_URL=
# PYBRAVO_DOCLING_TIMEOUT=

# ---------------------------------------------------------------------------
# Logging  (see docs/configuration.md)
# ---------------------------------------------------------------------------
# PYBRAVO_LOG_LEVEL=INFO
# PYBRAVO_LOG_FILE=
# PYBRAVO_LOG_DIR=
# Set to 1 for raw protocol frame hex dumps. Very verbose.
# PYBRAVO_PROTOCOL_TRACE=0

# ---------------------------------------------------------------------------
# Profiles
# ---------------------------------------------------------------------------
# Defaults to ./profiles relative to the working directory.
# PYBRAVO_PROFILE_DIR=

# ---------------------------------------------------------------------------
# Labware catalog and liquid classes
# ---------------------------------------------------------------------------
# MongoDB is optional. Without it, pyBravo falls back to local snapshot files
# and logs a warning on startup — that is expected, not an error.
# PYBRAVO_LABWARE_MONGO_URI=
# PYBRAVO_LABWARE_MONGO_DB=
# PYBRAVO_LABWARE_MONGO_COLLECTION=
# PYBRAVO_LABWARE_SNAPSHOT_PATH=
# PYBRAVO_LABWARE_EDITOR_PATH=
# PYBRAVO_LABWARE_EDITOR_ASSET_DIR=

# PYBRAVO_LIQUID_MONGO_URI=
# PYBRAVO_LIQUID_MONGO_DB=
# PYBRAVO_LIQUID_MONGO_CLASS_COLLECTION=
# PYBRAVO_LIQUID_MONGO_TECHNIQUE_COLLECTION=
# PYBRAVO_LIQUID_CLASS_STORE_PATH=

# ---------------------------------------------------------------------------
# Camera-based deck verification  (requires the `vision` extra)
# ---------------------------------------------------------------------------
# PYBRAVO_VISION_SERVICE_URL=
# Point at a still image to exercise the vision path with no camera attached.
# PYBRAVO_VISION_STATIC_IMAGE=
